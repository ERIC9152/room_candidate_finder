# room_candidate_finder: what is NOT in the Git repository (README section 0, "GitHub")
# Python environments (rebuilt by Setup.ps1; a Windows venv only runs on the computer that built it)
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# model weights: CoVisPose and HorizonNet are release assets; RoMa v2, DINOv3 code and ResNet-50 are downloaded by Setup.ps1
2_pose_floorplan/models/covispose/*.pt
2_pose_floorplan/models/horizonnet/*.pth
2_pose_floorplan/models/torch_home/
1_room_finder/models/torch_home/

# SAM3 (environment, weights and code, about 9 GB; without it the review uses the plain wedge)
1_room_finder/third_party/sam3-pano-seg/

# panoramas: the Dollhouse dataset and the viewer's panorama files (the 9 sample panoramas stay)
1_room_finder/data/
2_pose_floorplan/runs/*/viewer/images/

# ZInD: ground-truth poses taken from the ZInD annotations, and model outputs on ZInD images
# (regenerated by scripts/make_zind_room_groups.py and the evaluation launcher)
2_pose_floorplan/evaluation/zind_test_posegraph/gt.json
2_pose_floorplan/runs/zind_test_posegraph/predictions/

# scratch and locks
2_pose_floorplan/tmp/
**/RUNNING.lock
**/inference.lock
